OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {
    TASK {
        UINT32 STACKSIZE = 32768;
    };
    ISR {
        UINT32 STACKSIZE = 32768;
    };
};

CPU instrument_cluster {

    /* Operating System Configuration */
    OS config {
        STATUS = EXTENDED;

        BUILD = TRUE {
            APP_SRC = "main.c";
            TRAMPOLINE_BASE_PATH = "../../..";
            APP_NAME = "instrument_cluster_exe";
            LINKER = "gcc";
            SYSTEM = PYTHON;
        };
    };

    APPMODE stdAppmode {};

    /* Shared Resource */
    RESOURCE ICM_Resource {
        RESOURCEPROPERTY = STANDARD;
    };

    /* =====================================
       TASK CONFIGURATION
       ===================================== */

    /* Sensor Acquisition - 10 ms */
    TASK Task_Acquisition {
        PRIORITY = 3;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = ICM_Resource;
    };

    /* Data Processing - 20 ms */
    TASK Task_Processing {
        PRIORITY = 2;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = ICM_Resource;
    };

    /* Dashboard Display - 50 ms */
    TASK Task_Display {
        PRIORITY = 1;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = ICM_Resource;
    };

    /* Simulation Shutdown */
    TASK Task_Stop {
        PRIORITY = 4;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
    };

    /* CAN Reception - Event Driven */
TASK Task_CAN_RX {
    PRIORITY = 5;
    AUTOSTART = TRUE {
        APPMODE = stdAppmode;
    };
    ACTIVATION = 1;
    SCHEDULE = FULL;

    EVENT = Event_CAN_M1;
    EVENT = Event_CAN_M2;

    RESOURCE = ICM_Resource;
};

/* Diagnostics - 100 ms */
TASK Task_Diagnostics {
    PRIORITY = 2;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
    RESOURCE = ICM_Resource;
};

/* Logging - 1000 ms */
TASK Task_Logging {
    PRIORITY = 1;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
    RESOURCE = ICM_Resource;
};

    /* =====================================
       EVENT CONFIGURATION
       ===================================== */

    EVENT Event_CAN_M1 {
        MASK = AUTO;
    };

    EVENT Event_CAN_M2 {
        MASK = AUTO;
    };

    /* =====================================
       PERIODIC TASK ALARMS
       ===================================== */

    /* Acquisition - Every 1 tick */
    ALARM Alarm_Acquisition {
        COUNTER = SystemCounter;
        ACTION = ACTIVATETASK {
            TASK = Task_Acquisition;
        };
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
            ALARMTIME = 1;
            CYCLETIME = 1;
        };
    };

    /* Processing - Every 2 ticks */
    ALARM Alarm_Processing {
        COUNTER = SystemCounter;
        ACTION = ACTIVATETASK {
            TASK = Task_Processing;
        };
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
            ALARMTIME = 2;
            CYCLETIME = 2;
        };
    };

    /* Display - Every 5 ticks */
    ALARM Alarm_Display {
        COUNTER = SystemCounter;
        ACTION = ACTIVATETASK {
            TASK = Task_Display;
        };
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
            ALARMTIME = 5;
            CYCLETIME = 5;
        };
    };

    /* =====================================
       CAN MESSAGE ALARMS
       ===================================== */

    /* CAN M1 - Engine RPM - 500 ms */
    ALARM Alarm_CAN_M1 {
        COUNTER = SystemCounter;
        ACTION = SETEVENT {
            TASK = Task_CAN_RX;
            EVENT = Event_CAN_M1;
        };
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
            ALARMTIME = 50;
            CYCLETIME = 50;
        };
    };

    /* CAN M2 - Vehicle Speed - 1000 ms */
    ALARM Alarm_CAN_M2 {
        COUNTER = SystemCounter;
        ACTION = SETEVENT {
            TASK = Task_CAN_RX;
            EVENT = Event_CAN_M2;
        };
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
            ALARMTIME = 100;
            CYCLETIME = 100;
        };
    };

    /* Diagnostics - Every 10 ticks */
ALARM Alarm_Diagnostics {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK {
        TASK = Task_Diagnostics;
    };


    AUTOSTART = TRUE {
        APPMODE = stdAppmode;
        ALARMTIME = 10;
        CYCLETIME = 10;
    };
};

/* Logging - Every 100 ticks */
ALARM Alarm_Logging {
    COUNTER = SystemCounter;

    ACTION = ACTIVATETASK {
        TASK = Task_Logging;
    };

    AUTOSTART = TRUE {
        APPMODE = stdAppmode;
        ALARMTIME = 100;
        CYCLETIME = 100;
    };
};

    /* =====================================
       SIMULATION STOP
       ===================================== */

    ALARM Alarm_Stop {
        COUNTER = SystemCounter;
        ACTION = ACTIVATETASK {
            TASK = Task_Stop;
        };
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
            ALARMTIME = 1000;
            CYCLETIME = 0;
        };
    };

};